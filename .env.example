# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets. All secret values below are
# intentionally blank; the app will refuse to start (JWT_SECRET) or refuse to
# log in (ADMIN_*) until you fill them in.

# --- Store identity ---
STORE_NAME=Aronno Mart
APP_TIMEZONE=Asia/Dhaka

# --- Admin login (POST /api/auth/login) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- JWT ---
# Required. Must be at least 32 bytes long (HMAC-SHA256 requirement); the app
# refuses to start otherwise. Generate one with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# --- CORS ---
# Comma-separated exact origins for a separately hosted UI, e.g.
# https://chat.example.com,https://admin.example.com
# Empty disables CORS. Wildcards are rejected at startup.
CORS_ALLOWED_ORIGINS=

# --- Provider selection ---
# Provider used when a request doesn't send "provider": claude, gemini or openai.
DEFAULT_PROVIDER=claude
# Optional: a provider to retry with if the chosen one fails.
AI_FALLBACK_PROVIDER=

# --- Anthropic / Claude ---
CLAUDE_API_KEY=
# Check https://docs.anthropic.com/en/docs/about-claude/models for a current model name.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_TOKENS=2048

# --- Google Gemini ---
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for a current model name.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=2048

# --- OpenAI ---
OPENAI_API_KEY=
# Check https://platform.openai.com/docs/models for a current model name.
# Reasoning models spend part of this budget on hidden reasoning; raise it if
# answers come back empty.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_MAX_TOKENS=4096

# --- Chat guardrails / cost control ---
CHAT_HISTORY_MESSAGES=10
CHAT_HISTORY_CHAR_BUDGET=6000
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_MESSAGES_PER_CONVERSATION=100
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_MAX_AI_CALLS_PER_DAY=200

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5433/chatbot
DB_USERNAME=postgres
DB_PASSWORD=secret
# Host port docker compose publishes postgres on.
DB_HOST_PORT=5433

SERVER_PORT=8080
